@using TentacleOracle.Enums
@using TentacleOracle.Extensions
@namespace TentacleOracle.Components.Dialog

<MudDialog Style="background: var(--color-background); color: var(--color-text-secondary);" ContentClass="pa-0">
    <DialogContent>
        <div class="dish-dialog" aria-labelledby="dish-dialog-title">
            <header class="dialog-header">
                <h2 id="dish-dialog-title">@(IsEditing ? "Edit Dish" : "Add Dish")</h2>
                <button type="button" class="styled-button styled-button--icon" aria-label="Close dialog"
                        @onclick="Cancel"
                        disabled="@_saving">X
                </button>
            </header>

            <EditForm @key="_editContext" EditContext="_editContext" OnValidSubmit="SaveAsync" FormName="Dish">
                <DataAnnotationsValidator/>
                <fieldset class="dialog-fields" disabled="@_saving">
                    <div class="details-column">
                        <div class="form-field">
                            <label for="dish-name">Name</label>
                            <InputText id="dish-name" @bind-Value="_model.Name" maxlength="100" autofocus/>
                            <ValidationMessage For="@(() => _model.Name)"/>
                        </div>
                        <div class="form-field">
                            <label for="dish-category">Category</label>
                            <MudAutocomplete T="string" InputId="dish-category"
                                             Class="dish-dropdown category-autocomplete"
                                             PopoverClass="dish-dropdown-popover"
                                             OpenIcon="@DropdownChevron"
                                             CloseIcon="@DropdownChevron"
                                             @bind-Value="_model.Category"
                                             For="@(() => _model.Category)"
                                             SearchFunc="SearchCategoriesAsync"
                                             MinCharacters="0" MaxItems="@(null)"
                                             OpenOnFocus="true" Strict="false"
                                             CoerceText="false" CoerceValue="true"
                                             Immediate="true" DebounceInterval="0"
                                             ResetValueOnEmptyText="true" Clearable="false"
                                             Disabled="@_saving" MaxLength="100"
                                             Placeholder="None" Underline="false"
                                             Margin="Margin.Dense"/>
                            <ValidationMessage For="@(() => _model.Category)"/>
                        </div>
                        <div class="form-field">
                            <label for="dish-kcal">Calories / Serving</label>
                            <InputNumber id="dish-kcal" @bind-Value="_model.Kcal" min="0"/>
                            <ValidationMessage For="@(() => _model.Kcal)"/>
                        </div>
                        <div class="form-field">
                            <label for="dish-effort">Effort</label>
                            <MudSelect T="DishEffort" InputId="dish-effort" @bind-Value="_model.Effort"
                                       ToStringFunc="@(value => value.GetDisplayName())"
                                       For="@(() => _model.Effort)" Class="dish-dropdown"
                                       PopoverClass="dish-dropdown-popover" Underline="false" Margin="Margin.Dense"
                                       OpenIcon="@DropdownChevron" CloseIcon="@DropdownChevron"
                                       Disabled="@_saving" Dense="true">
                                @foreach (var value in Enum.GetValues<DishEffort>())
                                {
                                    <MudSelectItem Value="@value">@value.GetDisplayName()</MudSelectItem>
                                }
                            </MudSelect>
                            <ValidationMessage For="@(() => _model.Effort)"/>
                        </div>
                    </div>
                    <div class="ratings-column">
                        <div class="form-field">
                            <label for="dish-rating-alex">Rating A</label>
                            <MudSelect T="DishRating" InputId="dish-rating-alex" @bind-Value="_model.RatingA"
                                       ToStringFunc="@(value => value.GetDisplayName())"
                                       For="@(() => _model.RatingA)" Class="dish-dropdown"
                                       PopoverClass="dish-dropdown-popover" Underline="false" Margin="Margin.Dense"
                                       OpenIcon="@DropdownChevron" CloseIcon="@DropdownChevron"
                                       Disabled="@_saving" Dense="true">
                                @foreach (var value in Enum.GetValues<DishRating>())
                                {
                                    <MudSelectItem Value="@value">@value.GetDisplayName()</MudSelectItem>
                                }
                            </MudSelect>
                            <ValidationMessage For="@(() => _model.RatingA)"/>
                        </div>
                        <div class="form-field">
                            <label for="dish-rating-rainer">Rating B</label>
                            <MudSelect T="DishRating" InputId="dish-rating-rainer" @bind-Value="_model.RatingR"
                                       ToStringFunc="@(value => value.GetDisplayName())"
                                       For="@(() => _model.RatingR)" Class="dish-dropdown"
                                       PopoverClass="dish-dropdown-popover" Underline="false" Margin="Margin.Dense"
                                       OpenIcon="@DropdownChevron" CloseIcon="@DropdownChevron"
                                       Disabled="@_saving" Dense="true">
                                @foreach (var value in Enum.GetValues<DishRating>())
                                {
                                    <MudSelectItem Value="@value">@value.GetDisplayName()</MudSelectItem>
                                }
                            </MudSelect>
                            <ValidationMessage For="@(() => _model.RatingR)"/>
                        </div>
                    </div>
                    <div class="dialog-actions">
                        <button type="submit" class="styled-button">@(_saving ? "Saving…" : "Save")</button>
                        <button type="button" class="styled-button"
                                @onclick="Reset">@(IsEditing ? "Reset" : "Clear")</button>
                    </div>
                </fieldset>
                @if (_error != null)
                {
                    <p class="save-error" role="alert">@_error</p>
                }
            </EditForm>
        </div>
    </DialogContent>
</MudDialog>


