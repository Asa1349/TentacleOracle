@inherits TentacleOracle.Components.Base.LifetimeComponentBase

<div class="button-container">
    <div class="button-group">
        <button class="styled-button"
                @onclick="GenerateMealPlan" disabled="@IsBusy">
            Generate
        </button>

        <button class="styled-button"
                @onclick="AddDish" disabled="@IsBusy">
            Add
        </button>

        <button class="styled-button"
                @onclick="EditSelectedDish"
                disabled="@(IsBusy || SelectedDish == null)">
            Edit
        </button>

        <button class="styled-button"
                @onclick="DeleteSelectedDish"
                disabled="@(IsBusy || SelectedDish == null)">
            Delete
        </button>
    </div>
    @if (_error != null)
    {
        <p role="alert">@_error</p>
    }
</div>
