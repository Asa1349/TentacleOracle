@page "/dishes"
@inherits TentacleOracle.Components.Base.BasePageWithControlsComponent<TentacleOracle.Components.Controls.DishesControls>
@attribute [StreamRendering]

<div class="dishes-page">
    <h2>Dishes</h2>

    <div class="table-container">
        <table class="content">
            <thead>
            <tr>
                <th>Name</th>
                <th>Category</th>
                <th>kcal/Serving</th>
                <th>Effort</th>
                <th>Rating</th>
            </tr>
            </thead>
            <tbody>
            <DishesTableInteractive Dishes="_dishes"/>
            </tbody>
        </table>
    </div>

    <section class="dishes-bottom-section" aria-label="Generated meal list">
        <div class="panel-actions" role="group" aria-label="Panel controls">
            <button type="button" class="styled-button styled-button--icon" aria-label="Up" title="Up" disabled>
                <span class="panel-arrow panel-arrow-up" aria-hidden="true"></span>
            </button>
            <button type="button" class="styled-button styled-button--icon" aria-label="Down" title="Down" disabled>
                <span class="panel-arrow panel-arrow-down" aria-hidden="true"></span>
            </button>
            <button type="button" class="styled-button styled-button--icon" aria-label="Clear" title="Clear" disabled>
                <span class="panel-clear-symbol" aria-hidden="true">X</span>
            </button>
        </div>
        <div class="dishes-bottom-box" aria-live="polite" aria-atomic="true">
            @if (_generatedDishes is { Count: > 0 })
            {
                <ul class="generated-meal-list" role="listbox" aria-label="Generated meal list"
                    tabindex="0" aria-activedescendant="@SelectedGeneratedDishElementId"
                    @onkeydown="HandleMealPlanKeyDown">
                    @foreach (var dish in _generatedDishes)
                    {
                        var isSelected = dish.Id == _selectedGeneratedDishId;
                        <li @key="dish.Id" id="@($"generated-dish-{dish.Id}")" role="option"
                            aria-selected="@(isSelected ? "true" : "false")"
                            class="generated-meal-item @(isSelected ? "is-selected" : "")"
                            @onclick="() => SelectGeneratedDish(dish)">
                            <span class="generated-meal-name">@dish.Name</span>
                            <span class="generated-meal-calories">(@dish.Kcal kcal)</span>
                        </li>
                    }
                </ul>
            }
            else if (_generatedDishes != null)
            {
                <p class="empty-meal-list">No meal plan generated yet.</p>
            }
        </div>
    </section>
</div>
