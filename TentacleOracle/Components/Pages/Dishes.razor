@page "/dishes"
@inherits TentacleOracle.Components.Base.BasePageWithControlsComponent<TentacleOracle.Components.Controls.DishesControls>
@attribute [StreamRendering]

<div class="dishes-page">
    <h2>Dishes</h2>

    <div class="table-container">
        <table class="content">
            <thead>
            <tr>
                <th>Name</th>
                <th>Category</th>
                <th>kcal/Serving</th>
                <th>Effort</th>
                <th>Rating</th>
            </tr>
            </thead>
            <tbody>
            <DishesTableInteractive Dishes="@(_dishesLoaded ? MealPlan.Dishes : null)"/>
            </tbody>
        </table>
    </div>

    <section class="dishes-bottom-section" aria-label="Generated meal list">
        <div class="panel-actions" role="group" aria-label="Panel controls">
            <MudTooltip Text="Remove from plan">
                <button type="button" class="styled-button styled-button--icon" aria-label="Remove from plan"
                        @onclick="RemoveSelectedMeal" disabled="@(!CanRemoveMeal)">
                    <span class="panel-arrow panel-arrow-up" aria-hidden="true"></span>
                </button>
            </MudTooltip>
            <MudTooltip Text="Add to plan">
                <button type="button" class="styled-button styled-button--icon" aria-label="Add to plan"
                        @onclick="AddSelectedDishToMealPlan" disabled="@(!CanAddMeal)">
                    <span class="panel-arrow panel-arrow-down" aria-hidden="true"></span>
                </button>
            </MudTooltip>
            <MudTooltip Text="Clear plan">
                <button type="button" class="styled-button styled-button--icon" aria-label="Clear plan"
                        @onclick="ClearMealPlan" disabled="@(!CanClearMealPlan)">
                    <span class="panel-clear-symbol" aria-hidden="true">X</span>
                </button>
            </MudTooltip>
        </div>
        <div class="dishes-bottom-box" aria-live="polite" aria-atomic="true">
            @if (MealPlan.Entries.Count > 0)
            {
                <ul class="generated-meal-list" role="listbox" aria-label="Generated meal list"
                    tabindex="0" aria-activedescendant="@SelectedGeneratedDishElementId">
                    @foreach (var entry in MealPlan.Entries)
                    {
                        var isSelected = entry.Id == _selectedMealPlanEntryId;
                        <li @key="entry.Id" id="@($"generated-dish-{entry.Id}")" role="option"
                            aria-selected="@(isSelected ? "true" : "false")"
                            class="generated-meal-item @(isSelected ? "is-selected" : "")"
                            @onclick="() => SelectGeneratedDish(entry)">
                            <span class="generated-meal-name">@entry.Dish.Name</span>
                            <span class="generated-meal-calories">(@entry.Dish.Kcal kcal)</span>
                        </li>
                    }
                </ul>
            }
        </div>
    </section>
</div>
