@page "/settings"
@using TentacleOracle.Models
@inherits TentacleOracle.Components.Base.BasePageWithControlsComponent<TentacleOracle.Components.Controls.SettingsControls>

<h2>Settings</h2>

<EditForm @key="_editContext" EditContext="_editContext" OnValidSubmit="SaveValidSettingsAsync" FormName="Settings">
	<DataAnnotationsValidator/>
	<div class="settings-field">
		<label for="meal-count">Number of meals to generate</label>
		<InputNumber id="meal-count" @bind-Value="_model.MealCount"
		             min="@AppSettings.MinimumMealCount" max="@AppSettings.MaximumMealCount" step="1"
		             disabled="@(_busy || !_settingsLoaded)"
		             aria-describedby="meal-count-help"/>
		<p id="meal-count-help">Choose @AppSettings.MinimumMealCount–@AppSettings.MaximumMealCount meals.</p>
		<ValidationMessage For="@(() => _model.MealCount)"/>
	</div>
	@if (_saved)
	{
		<p class="settings-feedback" role="status">Settings saved.</p>
	}
	@if (_error != null)
	{
		<p class="validation-message" role="alert">@_error</p>
	}
</EditForm>
